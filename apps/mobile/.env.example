# Optional Nest API base URL override (no path).
#
# Leave this unset for local development. The app derives the backend host from
# Expo/Metro on physical devices, uses 10.0.2.2 on the Android emulator, and
# uses localhost on the iOS simulator.
#
# Set this only when the API is hosted somewhere other than the Metro machine,
# such as staging or production:
# EXPO_PUBLIC_NEST_API_URL=https://api.example.com
